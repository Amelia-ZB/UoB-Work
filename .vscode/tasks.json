{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Clang C Build",
            "command": "/usr/bin/clang",
            "args": [
                "-fdiagnostics-color=always",
                "-g",                     // Required: Generates debug symbols
                "${file}",                // Compiles the currently active C file
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}" // Output binary location
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}
